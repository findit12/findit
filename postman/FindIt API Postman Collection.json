{
  "info": {
    "name": "FindIt API Tests",
    "description": "Lab 5 and Lab 6: Postman collection of the FindIt REST API. Run the server (npm run dev), then run the whole collection. Variables: baseUrl, email, password (a verified student account).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Authentication (FR-01 to FR-04)",
      "item": [
        {
          "name": "POST /auth/register (creates the account, or 409 if it already exists)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "register"
              ]
            },
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\",\n  \"firstName\": \"Postman\",\n  \"lastName\": \"Tester\",\n  \"gdprConsent\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 201 (created) or 409 (already registered)\", function () {",
                  "  pm.expect([201, 409]).to.include(pm.response.code);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "POST /auth/login (stores the JWT in {{token}})",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"Answer contains a token and the user\", function () {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body).to.have.property(\"token\");",
                  "  pm.expect(body.user).to.have.property(\"id\");",
                  "  pm.collectionVariables.set(\"token\", body.token);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /auth/me",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/auth/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "me"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"The password hash is never returned\", function () {",
                  "  pm.expect(JSON.stringify(pm.response.json())).to.not.include(\"passwordHash\");",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /announcements/mine without token (must be refused)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/announcements/mine",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "announcements",
                "mine"
              ]
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 401\", function () { pm.response.to.have.status(401); });",
                  "pm.test(\"Error message is returned\", function () { pm.expect(pm.response.json()).to.have.property(\"error\"); });"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2. Gallery and reference data (FR-08, FR-09, FR-22)",
      "item": [
        {
          "name": "GET /reference-data (categories, objects, places)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/reference-data",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "reference-data"
              ]
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"Categories are an array\", function () {",
                  "  pm.expect(pm.response.json().categories).to.be.an(\"array\");",
                  "});",
                  "pm.test(\"Places are an array\", function () {",
                  "  pm.expect(pm.response.json().places).to.be.an(\"array\");",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /announcements (page 1, 12 per page)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/announcements?page=1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "announcements"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                }
              ]
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"data is an array of at most 12 items\", function () {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.data).to.be.an(\"array\");",
                  "  pm.expect(body.data.length).to.be.at.most(12);",
                  "});",
                  "pm.test(\"meta contains the pagination\", function () {",
                  "  pm.expect(pm.response.json().meta).to.have.property(\"totalPages\");",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /announcements with an invalid sort (must be refused)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/announcements?sort=bestMatch",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "announcements"
              ],
              "query": [
                {
                  "key": "sort",
                  "value": "bestMatch"
                }
              ]
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Best match without keyword gives 400\", function () { pm.response.to.have.status(400); });"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "3. Saved searches CRUD (Lab 6, FR-24)",
      "item": [
        {
          "name": "POST /saved-searches",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/saved-searches",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "saved-searches"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"q\": \"wallet\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 201\", function () { pm.response.to.have.status(201); });",
                  "pm.test(\"The new search has an id\", function () {",
                  "  const body = pm.response.json().savedSearch;",
                  "  pm.expect(body).to.have.property(\"id\");",
                  "  pm.collectionVariables.set(\"savedSearchId\", body.id);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /saved-searches",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/saved-searches",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "saved-searches"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"Answer is an array\", function () { pm.expect(pm.response.json().savedSearches).to.be.an(\"array\"); });"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /saved-searches/:id",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/saved-searches/{{savedSearchId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "saved-searches",
                "{{savedSearchId}}"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"It is the created search\", function () { pm.expect(pm.response.json().savedSearch.q).to.eql(\"wallet\"); });"
                ]
              }
            }
          ]
        },
        {
          "name": "PUT /saved-searches/:id (merge: only q changes)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/saved-searches/{{savedSearchId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "saved-searches",
                "{{savedSearchId}}"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"q\": \"backpack\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"q was updated\", function () { pm.expect(pm.response.json().savedSearch.q).to.eql(\"backpack\"); });"
                ]
              }
            }
          ]
        },
        {
          "name": "DELETE /saved-searches/:id",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/saved-searches/{{savedSearchId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "saved-searches",
                "{{savedSearchId}}"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 204\", function () { pm.response.to.have.status(204); });"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /saved-searches/:id after delete (must be 404)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/saved-searches/{{savedSearchId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "saved-searches",
                "{{savedSearchId}}"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 404\", function () { pm.response.to.have.status(404); });"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "4. Admin access control (NFR-SEC-03)",
      "item": [
        {
          "name": "GET /admin/claims as a student (must be refused)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/admin/claims",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "admin",
                "claims"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"A student gets 403\", function () { pm.response.to.have.status(403); });"
                ]
              }
            }
          ]
        },
        {
          "name": "POST /admin/scheduler/run as a student (must be refused)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/admin/scheduler/run",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "admin",
                "scheduler",
                "run"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"A student gets 403\", function () { pm.response.to.have.status(403); });"
                ]
              }
